# Public site architecture. The app determines its active origin at runtime, so
# preview deployments and localhost retain working OAuth/PWA behaviour. This
# value is reserved for deliberate links from the app back to the marketing
# site; leave it empty in ephemeral preview environments when no such link is
# rendered.
VITE_MARKETING_SITE_URL=https://freshgo.my

# ---------------------------------------------------------------------------
# Playwright (E2E)
# ---------------------------------------------------------------------------
# Controls the base URL Playwright tests run against. Defaults to the local
# Vite dev server when unset.
PLAYWRIGHT_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# TEST environment (for automated E2E tests)
# ---------------------------------------------------------------------------
# Copy `.env.test.example` to `.env.test` and fill in a SEPARATE Supabase test
# project's values. Playwright loads `.env.test` and seeds the Vite dev server
# with it. `.env` (production) is never used/modified for tests.
#
# TEST_SUPABASE_SERVICE_ROLE_KEY is optional and Node-only; it must NEVER be
# prefixed with VITE_ and must NEVER be exposed to the browser.
#
# See also: TESTS_RUN docs/testing.md
