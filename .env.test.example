# ============================================================================
# FreshGo TEST Environment  (.env.test)
# ----------------------------------------------------------------------------
# This file is GIT-IGNORED. It is loaded by Playwright only (see
# e2e/support/env.ts + playwright.config.ts). The production `.env` is never
# touched.
#
# To create the test environment:
#   1. Create a SEPARATE Supabase project (never the production one).
#   2. Apply the existing supabase/migrations/ to it.
#   3. Get its Project URL + anon key (from Project Settings -> API) and fill
#      them in below.
#   4. Optional: add a service-role key (Settings -> API -> service_role) if
#      you want fixture helpers to create test users. It is used ONLY from
#      Node.js test code. NEVER prefix it with VITE_ and never expose it to the
#      browser.
#   5. Choose per-role credentials, or leave them empty to let fixtures
#      generate run-scoped ones automatically.
# ============================================================================

# --- Supabase (test project) ------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Node-only, for future fixture setup. MUST NOT start with VITE_.
TEST_SUPABASE_SERVICE_ROLE_KEY=

# --- Playwright --------------------------------------------------------------
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Optional: pin a run identifier; otherwise one is generated per run
# (e.g. E2E-20260808-ABC123).
TEST_RUN_ID=

# --- Test users (optional overrides) ----------------------------------------
# Leave empty to auto-generate run-scoped emails/passwords in fixtures.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=
TEST_SUPPLIER_EMAIL=
TEST_SUPPLIER_PASSWORD=
TEST_RIDER_EMAIL=
TEST_RIDER_PASSWORD=