{
  "name": "FreshGo Test Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",

  "postCreateCommand": "npm ci && ./.devcontainer/setup-env.sh",

  "forwardPorts": [5173],

  "portsAttributes": {
    "5173": {
      "label": "FreshGo Web App",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
